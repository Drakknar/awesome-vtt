{{!-- Quick actions (the phone's launcher): a seat panel opened from the pill, in three tabs. --}}
<header class="avtt-panel-header">
  <strong><i class="fa-solid fa-bolt" inert></i> {{localize "AVTT.Quick.Title"}}</strong>
</header>
<nav class="avtt-tabs">
  {{#each tabs}}
  <button type="button" data-action="quickTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}"
          aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
  {{/each}}
</nav>
<div class="avtt-quick-body">
  {{#if (eq tab "quick")}}
  {{!-- Only the character's actions (the sheet's Actions tab), so attacks and spells are one click away. --}}
  {{> "modules/awesome-vtt/templates/actions.hbs"}}
  {{/if}}

  {{#if (eq tab "effects")}}
  {{#if deathSave}}
  <div class="avtt-death">
    <span><i class="fa-solid fa-skull" inert></i> {{localize "AVTT.Sheet.DeathSaves"}}: ✔ {{death.success}} · ✖ {{death.failure}}</span>
    <button type="button" data-action="deathSave" class="avtt-primary">{{localize "AVTT.Sheet.RollDeathSave"}}</button>
  </div>
  {{/if}}

  <div class="avtt-button-row">
    <button type="button" data-action="toggleInspiration" class="{{#if inspiration}}active{{/if}}"
            aria-pressed="{{#if inspiration}}true{{else}}false{{/if}}"><i class="fa-solid fa-star" inert></i> {{inspirationLabel}}</button>
  </div>

  {{#if quickConditions.length}}
  <div class="avtt-quick-chips">
    {{#each quickConditions}}
    <button type="button" data-action="toggleCondition" data-condition="{{id}}" class="{{#if active}}active{{/if}}"
            aria-pressed="{{#if active}}true{{else}}false{{/if}}"><img src="{{img}}" alt=""> {{label}}</button>
    {{/each}}
  </div>
  {{/if}}

  <div class="avtt-hp-row">
    <input type="number" name="hpAmount" min="0" max="999" step="1" inputmode="numeric" placeholder="0" aria-label="{{localize 'AVTT.Quick.Amount'}}">
    <div class="avtt-segmented" role="radiogroup" aria-label="{{localize 'AVTT.Quick.HpMode'}}">
      {{#each hpModes}}
      <button type="button" data-action="hpMode" data-mode="{{id}}" role="radio" class="avtt-{{id}} {{#if active}}selected{{/if}}"
              aria-checked="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
      {{/each}}
    </div>
    <button type="button" data-action="applyHp" class="avtt-apply">{{localize "AVTT.Sheet.Apply"}}</button>
  </div>

  {{#each concentration}}
  <div class="avtt-quick-line">
    <span><i class="fa-solid fa-brain" inert></i> {{name}}</span>
    <button type="button" data-action="endConcentration" data-effect-id="{{id}}">{{localize "AVTT.Quick.EndConcentration"}}</button>
  </div>
  {{/each}}

  {{#if exhaustion}}
  <div class="avtt-quick-line">
    <span>{{localize "AVTT.Quick.Exhaustion"}} {{exhaustion.value}}/{{exhaustion.max}}</span>
    <span class="avtt-adjust">
      <button type="button" data-action="exhaustion" data-delta="-1" data-tooltip="" aria-label="{{localize 'AVTT.Quick.ExhaustionLess'}}">−</button>
      <button type="button" data-action="exhaustion" data-delta="1" data-tooltip="" aria-label="{{localize 'AVTT.Quick.ExhaustionMore'}}">+</button>
    </span>
  </div>
  {{/if}}

  {{!-- Other trackers of the system (SotDL: insanity, corruption). --}}
  {{#each tracks}}
  <div class="avtt-quick-line">
    <span>{{label}} {{value}}{{#if max}}/{{max}}{{/if}}</span>
    <span class="avtt-adjust">
      <button type="button" data-action="trackAdjust" data-track="{{key}}" data-delta="-1" data-tooltip="" aria-label="{{localize 'AVTT.Quick.Less' name=label}}">−</button>
      <button type="button" data-action="trackAdjust" data-track="{{key}}" data-delta="1" data-tooltip="" aria-label="{{localize 'AVTT.Quick.More' name=label}}">+</button>
    </span>
  </div>
  {{/each}}

  <section class="avtt-group">
    <h4>{{localize "AVTT.Quick.Effects"}}</h4>
    <ul class="avtt-item-list">
      {{#each effects}}
      <li>
        <button type="button" data-action="toggleEffect" data-effect-uuid="{{uuid}}" class="{{#if active}}active{{/if}}"
                aria-pressed="{{#if active}}true{{else}}false{{/if}}">
          <img src="{{img}}" alt=""><span>{{name}}{{#if source}} <em>· {{source}}</em>{{/if}}</span>
          <i class="fa-solid {{#if active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" inert></i>
        </button>
      </li>
      {{else}}
      <li class="avtt-muted">{{localize "AVTT.Quick.NoEffects"}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if (eq tab "rest")}}
  <div class="avtt-button-row avtt-rest-row">
    {{#each rests}}
    <button type="button" data-action="{{action}}"><i class="fa-solid {{icon}}" inert></i> {{label}}</button>
    {{/each}}
  </div>
  {{/if}}
</div>
