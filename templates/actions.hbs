{{!-- Action rows (sheet Actions tab and quick actions): each group of usable items, with slots and uses. --}}
  {{#each actions}}
  <section class="avtt-group">
    <h4>{{label}}
      {{#if slots}}
      <span class="avtt-slots avtt-adjust">
        {{localize "AVTT.Sheet.Slots"}}
        <button type="button" data-action="slotAdjust" data-slot="{{slots.key}}" data-delta="-1" data-tooltip="" aria-label="{{localize 'AVTT.Sheet.SlotLess'}}">−</button>
        <span>{{slots.value}}/{{slots.max}}</span>
        <button type="button" data-action="slotAdjust" data-slot="{{slots.key}}" data-delta="1" data-tooltip="" aria-label="{{localize 'AVTT.Sheet.SlotMore'}}">+</button>
      </span>
      {{/if}}
    </h4>
    <ul class="avtt-item-list">
      {{#each items}}
      <li class="avtt-item-row">
        <button type="button" data-action="useItem" data-item-id="{{id}}">
          <img src="{{img}}" alt=""><span>{{name}}</span>
        </button>
        {{#if usesMax}}
        <span class="avtt-adjust">
          <button type="button" data-action="usesAdjust" data-item-id="{{id}}" data-delta="-1" data-tooltip="" aria-label="{{localize 'AVTT.Sheet.UseLess'}}">−</button>
          <span>{{usesValue}}/{{usesMax}}</span>
          <button type="button" data-action="usesAdjust" data-item-id="{{id}}" data-delta="1" data-tooltip="" aria-label="{{localize 'AVTT.Sheet.UseMore'}}">+</button>
        </span>
        {{/if}}
        {{!-- What the action does: the item's description, shown under the row (same as the inventory's). --}}
        {{#if @root.canFavorite}}
        <button type="button" data-action="toggleFavorite" data-item-id="{{id}}" data-tooltip="" class="avtt-favorite {{#if favorite}}active{{/if}}"
                aria-label="{{#if favorite}}{{localize 'AVTT.Sheet.Unfavorite' name=name}}{{else}}{{localize 'AVTT.Sheet.Favorite' name=name}}{{/if}}"
                aria-pressed="{{#if favorite}}true{{else}}false{{/if}}">
          <i class="{{#if favorite}}fa-solid{{else}}fa-regular{{/if}} fa-star" inert></i>
        </button>
        {{/if}}
        <button type="button" data-action="invDetails" data-item-id="{{id}}" data-tooltip=""
                class="avtt-item-info {{#if (lookup @root.state.inv.details id)}}active{{/if}}"
                aria-label="{{localize 'AVTT.Sheet.About' name=name}}"
                aria-expanded="{{#if (lookup @root.state.inv.details id)}}true{{else}}false{{/if}}">
          <i class="fa-solid fa-circle-info" inert></i>
        </button>
        {{#with (lookup @root.state.inv.details id) as |html|}}
        <div class="avtt-inv-details avtt-item-details">{{{html}}}</div>
        {{/with}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{else}}
  <p class="avtt-muted">{{localize "AVTT.Sheet.NoActions"}}</p>
  {{/each}}
